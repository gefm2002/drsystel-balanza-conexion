# Copiar a .env o definir estas variables en la terminal.
# IP fija/reserva DHCP de la Cuora MAX en la LAN del comercio.
SCALE_IP=192.168.1.50
# El puerto debe confirmarse en la unidad/manual. No asumir 4000.
SCALE_PORT=10001
# Puerto HTTP local del bridge.
PORT=3002
# Dirección de protocolo: confirmar con la unidad; la prueba COM previa usó 0.
SCALE_ADDRESS=0
